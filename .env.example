# World ID for the website. Copy to .env, which git ignores. Keep all five set, or the site offers local guest only.
# From https://developer.world.org: create the app, then the action, and save the signing key, which shows once.
WORLD_APP_ID=
WORLD_ACTION=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# staging works with the simulator. production needs the RP registration to show "registered".
WORLD_ENVIRONMENT=

# Arc testnet, for policy/bounty/arc_mirror.py only. Steps: docs/SWITCH-ON.md. Do not set a private key anywhere.
ARC_RPC_URL=
ARC_WALLET_DIR=
ARC_CAP_USDC=

# 0G Private Computer, for the AI. Set CRASHLAB_LLM to 0g to choose it.
CRASHLAB_LLM=
ZG_API_KEY=
ZG_MODEL=
ZG_ROUTER_URL=
ZG_TIMEOUT_S=
ZG_FALLBACK_CLAUDE=
ZG_RPC_URL=

# 0G Storage testnet, for policy/crashlab/zg_storage.py only.
ZG_WALLET_KEYSTORE=
ZG_WALLET_PASSWORD_FILE=
ZG_STORAGE_RPC=
ZG_STORAGE_INDEXER=
