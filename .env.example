# Names only. Copy to .env and fill in. Git ignores .env and .env.*, except this file. Steps: docs/SWITCH-ON.md.
# .env is for the web and LLM processes. Signing keystores go in .env.resolver and .env.tester, never here.

# 0G backend B. Set CRASHLAB_LLM to 0g to choose it.
CRASHLAB_LLM=
ZG_API_KEY=
ZG_MODEL=
ZG_ROUTER_URL=
ZG_RPC_URL=

# World ID
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=
WORLD_VERIFY_URL=
WORLD_HUMAN_CAP=
WORLD_ALLOW_LEGACY=
WORLD_DB=

# Arc, read side
ARC_RPC_URL=
ARC_BOUNTY_ADDRESS=
ARC_BOUNTY_ID=
ARC_USDC_ADDRESS=
ARC_TESTER_ADDRESS=
ARC_SPEC_DIR=
ARC_FROM_BLOCK=
ARC_CAST_BIN=
ARC_RESOLVER_DIR=

# Deploy script only. Set these in the deploy shell.
ARC_COMPANY_ADDRESS=
ARC_RESOLVER_ADDRESS=
ARC_ARBITER_ADDRESS=
ARC_SPEC_HASH=
ARC_CAP_BASE_UNITS=
ARC_PER_FAILURE_BASE_UNITS=
ARC_TOP_PRIZE_BASE_UNITS=
ARC_DEADLINE_SECONDS=
ARC_GRACE_SECONDS=
ARC_DISPUTE_WINDOW_SECONDS=

# .env.resolver only
ARC_RESOLVER_KEYSTORE=
ARC_RESOLVER_PASSWORD_FILE=
ARC_REQUIRE_WORLD_ID=

# .env.tester only
ARC_TESTER_KEYSTORE=
ARC_TESTER_PASSWORD_FILE=
